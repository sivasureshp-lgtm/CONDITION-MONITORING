# ============================================================
# Neutral Glass Condition Monitoring - Environment Variables
# Copy this to .env for local testing
# On Render: Set these in Dashboard > Environment
# ============================================================

# Google Sheets (REQUIRED - this is your database)
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEET_ID=your_google_sheet_id_here
# For Render: paste the entire service_account.json content as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Cloudinary (OPTIONAL - for photo storage)
# Get this from cloudinary.com > Dashboard > API Environment variable
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# CORS (allow frontend to call API)
CORS_ORIGINS=*

# Render self-ping (auto-set by Render, or set manually)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
